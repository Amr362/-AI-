PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://your-domain.com

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_BASE_URL=https://your-domain.com
DEFAULT_LANGUAGE=ar-EG
ENABLE_TWILIO_SIGNATURE_VALIDATION=false
TWILIO_DEFAULT_VOICE=Polly.Zeina
TWILIO_ENGLISH_VOICE=Polly.Joanna

# Optional Redis (fallback to in-memory when empty)
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=900

# Multi-store JSON map (merchantId keyed)
MERCHANTS_JSON={}
DEFAULT_MERCHANT_ID=demo

# Optional Twilio called-number to merchant map
MERCHANT_PHONE_MAP_JSON={}

# Optional product catalog fallback
PRODUCT_CATALOG_JSON=[{"sku":"P-001","name":"Premium Headphones","price":1299,"currency":"EGP","stock":20,"shipping":"1-3 business days"}]

# Lemon Squeezy Billing
LEMON_API_KEY=lemon_xxx
LEMON_WEBHOOK_SECRET=whsec_xxx
LEMON_STORE_ID=12345
LEMON_API_BASE_URL=https://api.lemonsqueezy.com/v1
LEMON_PLAN_VARIANT_MAP_JSON={"starter":"111","professional":"222","enterprise":"333"}
LEMON_CREDITS_VARIANT_ID=444

# Optional email notifier (console-only fallback if empty)
SMTP_FROM_EMAIL=billing@your-saas.com
